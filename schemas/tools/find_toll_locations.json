{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "find_toll_locations",
  "version": "1.0.0",
  "description": "Progressive-disclosure search over every corridor's committed interchange labels (i95, i495, i66 inside-the-beltway, i66 outside-the-beltway [unpriced], dulles_toll_road, dulles_greenway), so a caller can go from a vague human location (\"Springfield\", \"Tysons\") or a partial/misspelled label to the exact label string i95_route/i495_route/i66_route/dulles_route expect. No RDS, no network -- reads the same committed oracle files those tools already load. Design: docs/oracle-tools-spec.md; version enforced by tests/test_tool_schemas.py.",
  "input": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "Free text: an interchange label substring, a common NoVA place/locality name, a raw node id, or a misspelling of any of those. Case/punctuation-insensitive. Omit (or pass \"\") to get the corridor menu instead of a label search."
      },
      "corridor": {
        "type": "string",
        "enum": ["i95", "i495", "i66_itb", "i66_otb", "dulles_toll_road", "dulles_greenway"],
        "description": "Restrict the search to one corridor id. Omit to search every corridor."
      }
    },
    "required": [],
    "additionalProperties": false,
    "examples": [
      {},
      { "query": "Springfield" },
      { "query": "Tysons", "corridor": "i495" },
      { "corridor": "i66_otb" }
    ]
  },
  "$defs": {
    "corridor_summary": {
      "type": "object",
      "properties": {
        "corridor": { "type": "string", "enum": ["i95", "i495", "i66_itb", "i66_otb", "dulles_toll_road", "dulles_greenway"] },
        "pricing_tool": {
          "type": ["string", "null"],
          "enum": ["i95_route", "i495_route", "i66_route", "dulles_route", null],
          "description": "null only for i66_otb -- no pricing tool exists for I-66 Outside the Beltway in this repo."
        },
        "priced": { "type": "boolean" },
        "label_count": { "type": "integer" }
      },
      "required": ["corridor", "pricing_tool", "priced", "label_count"],
      "additionalProperties": false
    },
    "match": {
      "type": "object",
      "properties": {
        "corridor": { "type": "string", "enum": ["i95", "i495", "i66_itb", "i66_otb", "dulles_toll_road", "dulles_greenway"] },
        "label": { "type": "string" },
        "node_id": { "type": "string" },
        "pricing_tool": {
          "type": ["string", "null"],
          "enum": ["i95_route", "i495_route", "i66_route", "dulles_route", null]
        },
        "priced": { "type": "boolean" },
        "entry_capable": {
          "type": ["boolean", "null"],
          "description": "null only for i66_otb nodes -- exit-capability was never observed for that facility, so entry_capable/exit_capable are unverified rather than a guessed false."
        },
        "exit_capable": { "type": ["boolean", "null"] }
      },
      "required": ["corridor", "label", "node_id", "pricing_tool", "priced", "entry_capable", "exit_capable"],
      "additionalProperties": false
    }
  },
  "output": {
    "oneOf": [
      {
        "type": "object",
        "description": "Corridor menu, returned when query is omitted or blank.",
        "properties": {
          "corridors": {
            "type": "array",
            "items": { "$ref": "#/$defs/corridor_summary" }
          }
        },
        "required": ["corridors"],
        "additionalProperties": false
      },
      {
        "type": "object",
        "description": "Search result, returned when query is given and at least one label matches.",
        "properties": {
          "query": { "type": "string" },
          "matches": {
            "type": "array",
            "maxItems": 20,
            "items": { "$ref": "#/$defs/match" }
          }
        },
        "required": ["query", "matches"],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "An unknown corridor id, or a query that matched nothing even after the locality-alias and typo-tolerant fallback."
          },
          "valid_options": {
            "type": "array",
            "items": { "type": "string" },
            "description": "The full list of valid corridor ids, so the caller can retry narrower or broader."
          }
        },
        "required": ["error", "valid_options"],
        "additionalProperties": false
      }
    ],
    "examples": [
      {
        "corridors": [
          { "corridor": "dulles_greenway", "pricing_tool": "dulles_route", "priced": true, "label_count": 10 },
          { "corridor": "dulles_toll_road", "pricing_tool": "dulles_route", "priced": true, "label_count": 10 },
          { "corridor": "i495", "pricing_tool": "i495_route", "priced": true, "label_count": 32 },
          { "corridor": "i66_itb", "pricing_tool": "i66_route", "priced": true, "label_count": 17 },
          { "corridor": "i66_otb", "pricing_tool": null, "priced": false, "label_count": 22 },
          { "corridor": "i95", "pricing_tool": "i95_route", "priced": true, "label_count": 62 }
        ]
      },
      {
        "query": "reston",
        "matches": [
          {
            "corridor": "dulles_toll_road",
            "label": "Exit 12 - SR 602 (Reston Pkwy)",
            "node_id": "12",
            "pricing_tool": "dulles_route",
            "priced": true,
            "entry_capable": true,
            "exit_capable": true
          }
        ]
      },
      {
        "error": "unknown corridor 'i66'",
        "valid_options": ["dulles_greenway", "dulles_toll_road", "i495", "i66_itb", "i66_otb", "i95"]
      }
    ]
  }
}
