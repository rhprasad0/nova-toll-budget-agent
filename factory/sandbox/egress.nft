table inet factory_sandbox
delete table inet factory_sandbox

table inet factory_sandbox {
  chain output {
    type filter hook output priority filter; policy accept;
    meta skuid "factory-read" ct original ip daddr 10.249.0.1 ct original proto-dst 18080 accept
    meta skuid "factory-write" ct original ip daddr 10.249.0.1 ct original proto-dst 18081 accept
    meta skuid { "factory-read", "factory-write" } counter reject
  }
}
