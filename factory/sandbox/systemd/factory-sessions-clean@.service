[Unit]
Description=Remove week-old TollChat factory session workdirs for %i
Requires=user@%i.service
After=user@%i.service

[Service]
Type=oneshot
User=%i
ExecStart=/bin/sh -c 'export DOCKER_HOST=unix:///run/user/$(id -u)/docker.sock; exec docker run --rm --volume "$HOME/sessions:/sessions" --entrypoint find factory-sandbox:latest /sessions -mindepth 1 -maxdepth 1 -mtime +7 -exec rm -rf {} +'
