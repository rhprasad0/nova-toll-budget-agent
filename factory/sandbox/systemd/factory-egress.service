[Unit]
Description=Limit TollChat factory sandbox users to their proxies
DefaultDependencies=no
Before=network-pre.target systemd-user-sessions.service
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/factory-sandbox/egress.nft

[Install]
WantedBy=multi-user.target
