#!/usr/bin/env bash
# Mirrors .github/workflows/ci.yml's check job before allowing a commit.
# One-time setup per clone: git config core.hooksPath .githooks
set -euo pipefail

files=$(git diff --cached --name-only --diff-filter=ACM -- '*.py')
[ -z "$files" ] && exit 0

if ! uv run ruff check $files || ! uv run ruff format --check $files; then
    echo "Lint failed. Run 'uv run ruff format' and 'uv run ruff check --fix' to clean up, then re-stage." >&2
    exit 1
fi

# pyright/pytest run whole-project (not just staged files) -- cross-file type
# errors like an executionEnvironment misconfig don't show up scoped to one
# file, which is exactly what slipped through to CI last time.
if ! uv run pyright; then
    echo "Type check failed." >&2
    exit 1
fi

if ! uv run pytest; then
    echo "Tests failed." >&2
    exit 1
fi
