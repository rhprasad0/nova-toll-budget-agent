#!/usr/bin/env bash
# Setup and tool versions: v2/README.md. CI remains authoritative.
set -euo pipefail
if ! command -v python3 >/dev/null 2>&1; then
    echo "Missing required python3. Follow the development setup in v2/README.md." >&2
    exit 1
fi
repository=$(git rev-parse --show-toplevel)
exec python3 "$repository/v2/scripts/check_repository.py" --staged
