#!/usr/bin/env bash
# Mirrors .github/workflows/ci.yml's check job before allowing a commit.
# One-time setup per clone: git config core.hooksPath .githooks
#
# This is the only secrets gate that applies regardless of what's
# committing (terminal, an editor, any AI agent) -- .claude/hooks/gitleaks-guard.sh
# only fires for Claude Code's own Bash tool calls. CI (.github/workflows/gitleaks.yml)
# is still the only gate nothing can bypass, since core.hooksPath is local,
# uncommitted git config -- a fresh clone has no hook until this is set.
set -euo pipefail

if command -v gitleaks >/dev/null 2>&1; then
    if ! gitleaks protect --staged --redact -v; then
        echo "BLOCKED: gitleaks found secrets in staged changes. Fix or unstage, then retry." >&2
        exit 1
    fi
else
    echo "gitleaks not installed locally; skipping (CI will still catch it)" >&2
fi

files=$(git diff --cached --name-only --diff-filter=ACM -- '*.py')
[ -z "$files" ] && exit 0

if ! uv run ruff check $files || ! uv run ruff format --check $files; then
    echo "Lint failed. Run 'uv run ruff format' and 'uv run ruff check --fix' to clean up, then re-stage." >&2
    exit 1
fi

# pyright/pytest run whole-project (not just staged files) -- cross-file type
# errors like an executionEnvironment misconfig don't show up scoped to one
# file, which is exactly what slipped through to CI last time.
if ! uv run pyright; then
    echo "Type check failed." >&2
    exit 1
fi

if ! uv run pytest; then
    echo "Tests failed." >&2
    exit 1
fi
