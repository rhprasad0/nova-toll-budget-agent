{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [
      "node"
    ],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "../**/*.js",
    "../**/*.mjs",
    "../**/*.cjs",
    "../**/*.ts",
    "../**/*.mts",
    "../**/*.cts"
  ],
  "exclude": [
    "../**/node_modules/**",
    "../**/.venv/**",
    "../.worktrees/**",
    "../infra/build/**",
    "infra/build/**",
    "agent/**"
  ]
}
