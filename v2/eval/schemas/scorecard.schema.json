{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tollchat:eval-graph:scorecard",
  "title": "Eval graph scorecard",
  "type": "object",
  "required": [
    "case_id",
    "pass",
    "checks",
    "rubric",
    "grader",
    "identity",
    "failure_class",
    "tokens",
    "latency_ms"
  ],
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "pass": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "pass",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "pass": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "enum": [
              "matched",
              "check failed"
            ]
          }
        }
      }
    },
    "rubric": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "grader": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identity": {
      "type": "object",
      "required": [
        "model",
        "prompt_hash",
        "tool_contract_hash",
        "dataset_hash",
        "commit",
        "artifact_digest",
        "grader_digest",
        "trial_id"
      ],
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "prompt_hash": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "tool_contract_hash": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "dataset_hash": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "artifact_digest": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "grader_digest": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "trial_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "failure_class": {
      "type": "string",
      "enum": [
        "none",
        "agent_quality",
        "infra_dependency"
      ]
    },
    "tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "latency_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  }
}
