FROM node:22-bookworm-slim AS codex
RUN npm install --global @openai/codex@0.157.1
FROM python:3.13-slim-bookworm
COPY --from=codex /usr/local/lib/node_modules/@openai/codex/node_modules/@openai/codex-linux-x64/vendor/x86_64-unknown-linux-musl/ /opt/codex/
COPY site/ /opt/site/
COPY kit/ /opt/kit/
COPY config.toml requirements.toml /etc/codex/
COPY runtime.py /opt/runtime.py
RUN mkdir /private /output /auth && chown 1000:1000 /private /output /auth && chmod 700 /auth
ENV PATH="/opt/codex/bin:${PATH}" PYTHONPATH=/opt/kit:/opt/site PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OTEL_SDK_DISABLED=true
USER 1000:1000
WORKDIR /private
ENTRYPOINT ["python", "/opt/runtime.py"]
CMD ["selfcheck"]
