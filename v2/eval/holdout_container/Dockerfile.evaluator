# The context contains cross-installed ARM64 wheels; no target RUN is needed.
FROM --platform=linux/arm64 python:3.13-slim-bookworm
COPY site/ /opt/site/
COPY evaluator/ /opt/evaluator/
COPY runtime.py /opt/runtime.py
COPY --chown=1000:1000 empty/ /private/
COPY --chown=1000:1000 empty/ /output/
ENV PYTHONPATH=/opt/evaluator:/opt/site PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OTEL_SDK_DISABLED=true AWS_EC2_METADATA_DISABLED=true
USER 1000:1000
WORKDIR /output
ENTRYPOINT ["python", "/opt/runtime.py"]
CMD ["preflight"]
