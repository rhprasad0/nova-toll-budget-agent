{
  "name": "TollChat Evaluation Factory",
  "build": { "dockerfile": "../Dockerfile", "context": ".." },
  "workspaceMount": "source=tollchat-factory-private,target=/private,type=volume",
  "workspaceFolder": "/private/work",
  "containerUser": "factory",
  "remoteUser": "factory",
  "updateRemoteUserUID": false,
  "containerEnv": {
    "CODEX_HOME": "/private/agent-state/codex",
    "HOME": "/private/agent-state/home",
    "FACTORY_ROOT": "/private/work"
  },
  "runArgs": [
    "--cap-drop=ALL",
    "--security-opt=no-new-privileges",
    "--security-opt=seccomp=${localWorkspaceFolder}/.devcontainer/seccomp.json"
  ],
  "postCreateCommand": "mkdir -p /private/work /private/agent-state/home /private/agent-state/codex /private/agent-state/aws /private/agent-state/tailscale && chmod 700 /private/agent-state /private/agent-state/aws /private/agent-state/tailscale",
  "postStartCommand": "sh /opt/factory/v2/eval/factory/start-tailscale.sh",
  "waitFor": "postStartCommand",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "openai.chatgpt"],
      "settings": {
        "python.defaultInterpreterPath": "/opt/factory/v2/.venv/bin/python",
        "python.terminal.activateEnvironment": false,
        "python-envs.terminal.autoActivationType": "off"
      }
    }
  }
}
