// nova-toll-budget-agent's Tailscale policy file, managed via GitOps
// (.github/workflows/tailscale-acl.yml) rather than the admin console.
// Pushes to main apply it; PRs only run the tests below. Manual console
// edits get overwritten on the next push -- see docs/tailscale-bridge-tasks.md.
{
    "tagOwners": {
        // The nova-toll RDS subnet router (infra/tailscale.tf).
        "tag:nova-toll-router": ["rhprasad0@github"],
        // Ephemeral GitHub Actions CI runners (tailscale/github-action in
        // .github/workflows/ci.yml's `integration` job).
        "tag:ci": ["rhprasad0@github"],
        // Account-local development subnet router; route activation is a
        // separately authorized Slice 2B operation.
        "tag:nova-toll-development-router": ["rhprasad0@github"],
        // Ephemeral GitHub Actions development runners.
        "tag:ci-development": ["rhprasad0@github"],
    },

    // Auto-approve the subnet route and exit-node use once the router is
    // tagged tag:nova-toll-router, so re-creating the instance doesn't
    // need a manual click in the console every time.
    "autoApprovers": {
        "routes": {
            "172.31.0.0/16": ["tag:nova-toll-router"],
            "fd7a:115c:a1e0:b1a:0:1:ac1f:0/112": [
                "tag:nova-toll-development-router"
            ],
        },
        "exitNode": ["tag:nova-toll-router"],
    },

    "grants": [
        // Owner keeps full access to everything on the tailnet (personal
        // devices, etc.) -- service identities below get scoped-down
        // grants instead of blanket access.
        {
            "src": ["rhprasad0@github"],
            "dst": ["*"],
            "ip":  ["*"],
        },

        // CI can reach RDS through the subnet router, and nothing else --
        // not the rest of the VPC, not the exit node, not other devices.
        {
            "src": ["tag:ci"],
            "dst": ["172.31.0.0/16"],
            "ip":  ["tcp:5432"],
        },
        // Development uses the site-1 4via6 route because its VPC overlaps
        // production's IPv4 CIDR; it has no IPv4 or exit-node grant.
        {
            "src": ["tag:ci-development"],
            "dst": ["fd7a:115c:a1e0:b1a:0:1:ac1f:0/112"],
            "ip":  ["tcp:5432"],
        },
    ],

    "ssh": [
        {
            "action": "check",
            "src":    ["autogroup:member"],
            "dst":    ["autogroup:self"],
            "users":  ["autogroup:nonroot", "root"],
        },
    ],

    // tests' accept/deny don't support CIDR ranges (confirmed: "unknown
    // user or host" on the /16) -- they need a concrete IP, so this aliases
    // RDS's current private IP (nova-toll-db, resolved via dig once RDS
    // went private). Update if RDS's underlying host ever changes it.
    "hosts": {
        "nova-toll-rds": "172.31.83.200",
        // Current development RDS address, transported over site-1 4via6.
        "nova-toll-rds-development": "fd7a:115c:a1e0:b1a:0:1:ac1f:4a7/128",
        // Representative address in the private preview subnets. The ALB IPs
        // are dynamic; this verifies the same CIDR/port policy without pinning one.
        "tollchat-preview-test": "172.31.224.10",
    },

    // Checked on every push; Tailscale rejects the update if any fail, so
    // a bad edit can't silently lock out the owner or widen tag:ci's reach.
    "tests": [
        {
            "src":    "rhprasad0@github",
            "accept": ["nova-toll-rds:5432", "tollchat-preview-test:443"],
        },
        {
            "src":    "tag:ci",
            "accept": ["nova-toll-rds:5432"],
            "deny":   [
                "nova-toll-rds-development:5432",
                "8.8.8.8:443",
                "tollchat-preview-test:443",
            ],
        },
        {
            "src":    "tag:ci-development",
            "accept": ["nova-toll-rds-development:5432"],
            "deny":   [
                "nova-toll-rds:5432",
                "nova-toll-rds-development:443",
                "tollchat-preview-test:443",
            ],
        },
    ],
}
